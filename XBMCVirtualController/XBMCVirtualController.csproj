<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>XBMCVirtualController</RootNamespace>
    <AssemblyName>XBMCVirtualController</AssemblyName>
    <ApplicationIcon>remotecontrol.ico</ApplicationIcon>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Product>XBMC Virtual Controller</Product>
    <Company>Team Blackbolt</Company>
    <Copyright>Copyright © Team Blackbolt 2009</Copyright>
    <AssemblyTitle>XBMCVirtualController</AssemblyTitle>
    <Description>Team Blackbolt - XBMC Virtual Remote</Description>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Version>1.1.0</Version>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- CS8981: the lower-case 'skin'/'skinControl'/... type names are the XML
         element names the skin serializer binds to; renaming them would break
         every existing Skin.xml. -->
    <NoWarn>$(NoWarn);CS8981</NoWarn>
  </PropertyGroup>

  <!-- Match the .NET Framework 2.0 rendering the forms were laid out against:
       DPI-unaware (the OS bitmap-scales the layered window, as it always did)
       and the old default WinForms font, so the designers' AutoScaleDimensions
       baselines still hold. -->
  <PropertyGroup>
    <ApplicationHighDpiMode>DpiUnaware</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationDefaultFont>Microsoft Sans Serif, 8.25pt</ApplicationDefaultFont>
  </PropertyGroup>

  <!-- Single-file, self-contained publish: one .exe with no .NET runtime prerequisite.
       The Skins folder and the loose PNGs are still deployed next to the exe. -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <!-- WinForms is not trim- or AOT-safe; keep both off. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Skins\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="credits.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="splash.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="RemoteControl.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="remotecontrol.ico" />
    <None Include="skin.xsd" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PerPixelAlphaForm\PerPixelAlphaForm.csproj" />
  </ItemGroup>

</Project>
